{
  "manifest_version": 3,
  "name": "Parallax — Hidden Prompt Injection Defense",
  "version": "0.1.0",
  "description": "Locally detects hidden, instruction-like text before browser agents extract it.",
  "action": { "default_popup": "popup.html", "default_title": "Parallax report" },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }],
  "permissions": ["storage"],
  "host_permissions": []
}
